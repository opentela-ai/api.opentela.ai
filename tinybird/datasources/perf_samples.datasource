TOKEN perf_append APPEND

DESCRIPTION >
    One row per proxied inference response (see internal/perf). Anonymous by
    construction: peer_fp is a truncated sha256 of the serving peer id; no API
    keys, prompts or payloads are ever written.

SCHEMA >
    ts DateTime64(3) `json:$.ts`,
    service LowCardinality(String) `json:$.service`,
    route LowCardinality(String) `json:$.route`,
    model LowCardinality(String) `json:$.model`,
    peer_fp FixedString(16) `json:$.peer_fp`,
    gpu_model LowCardinality(String) `json:$.gpu_model`,
    gpu_count UInt8 `json:$.gpu_count`,
    status UInt16 `json:$.status`,
    client_abort Bool `json:$.client_abort`,
    ttft_ms Float32 `json:$.ttft_ms`,
    first_token_ms Float32 `json:$.first_token_ms`,
    total_ms Float32 `json:$.total_ms`,
    input_tokens UInt32 `json:$.input_tokens`,
    output_tokens UInt32 `json:$.output_tokens`,
    response_bytes UInt64 `json:$.response_bytes`,
    gpu_ms UInt64 `json:$.gpu_ms`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toDate(ts)"
ENGINE_SORTING_KEY "gpu_model, model, ts"
ENGINE_TTL "toDate(ts) + INTERVAL 30 DAY"
